{
  "name": "inventos",
  "version": "0.1.0",
  "description": "InventOS \u2014 instalador de terminal para stacks open-source. Seguro de f\u00e1brica, espa\u00f1ol-first, en tu propio servidor. Por Invent Agency.",
  "type": "module",
  "bin": {
    "inventos": "dist/inventos.mjs"
  },
  "scripts": {
    "dev": "node bin/inventos.mjs",
    "gui": "node bin/inventos.mjs gui",
    "gui:dev": "npm --prefix gui run dev",
    "demo": "node bin/inventos.mjs --demo",
    "build:gui": "npm --prefix gui install --no-audit --no-fund && npm --prefix gui run build",
    "build:cli": "esbuild bin/inventos.mjs --bundle --platform=node --format=esm --target=node24 --external:bcryptjs --outfile=dist/inventos.mjs",
    "build:gui-server": "esbuild src/gui-server.mjs --bundle --platform=node --format=esm --target=node24 --external:bcryptjs --outfile=dist/gui-server.mjs",
    "build": "npm run build:gui && npm run build:cli",
    "app": "npm run build:gui-server && electron electron/main.mjs",
    "dist:mac": "npm run build:gui && npm run build:gui-server && electron-builder --mac",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "keywords": [
    "self-hosting",
    "docker",
    "swarm",
    "traefik",
    "supabase",
    "n8n",
    "cli",
    "installer",
    "invent"
  ],
  "author": "Invent Agency (inventagency.co)",
  "license": "MIT",
  "homepage": "https://os.inventagency.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebasInvent/inventos.git"
  },
  "bugs": {
    "url": "https://github.com/SebasInvent/inventos/issues"
  },
  "files": [
    "dist",
    "dist-gui",
    "src",
    "templates",
    "README.md"
  ],
  "build": {
    "appId": "co.inventagency.inventos",
    "productName": "InventOS",
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-gui/**/*",
      "templates/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "templates/**/*",
      "dist-gui/**/*"
    ],
    "mac": {
      "icon": "assets/brand/InventOS.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "InventOS"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  }
}
